<?xml version="1.0"?>
<package format="3">
  <name>behavior_cloning</name>
  <version>0.1.0</version>
  <description>Reproducible RGB and RGB-D behavior-cloning pipeline for FSDS.</description>

  <maintainer email="satvara@example.com">satvara</maintainer>
  <license>GPL-2.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>fs_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>teleop</exec_depend>
  <exec_depend>single_test</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
