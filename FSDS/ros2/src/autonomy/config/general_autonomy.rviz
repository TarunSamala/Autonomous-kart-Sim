Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.30
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 190; 190; 190
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Track Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: fsds/map
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 245; 92; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.10
      Name: Oracle Reference Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/reference_path
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 230; 40; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.09
      Name: Controller Local Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/local_path
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 90; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Current LiDAR
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fsds/lidar/Lidar1
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.45
      Name: Vehicle TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 248; 248; 246
    Fixed Frame: fsds/map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Track Overview
      Scale: 45
      Target Frame: fsds/map
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
