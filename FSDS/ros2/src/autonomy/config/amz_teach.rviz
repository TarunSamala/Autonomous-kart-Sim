Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 210; 210; 210
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Global Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: slam/map
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: SLAM Occupancy Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 90; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Current LiDAR
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fsds/lidar/Lidar1
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Persistent Cone and Midpoint Map
      Namespaces:
        mapped_left: true
        mapped_midpoints: true
        mapped_right: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/map/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Current Delaunay Triangulation
      Namespaces:
        candidate_paths: true
        selected_path: true
        triangulation: true
        valid_gates: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/debug/delaunay_planner
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 245; 92; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.09
      Name: Persistent Delaunay Centreline
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/map/centerline
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 35; 35; 35
      Enabled: true
      Line Style: Lines
      Line Width: 0.07
      Name: Manually Taught Centreline
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/recorded_route
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 30; 144; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.10
      Name: Loaded Global Route
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/global_route
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 230; 40; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.09
      Name: Controller Local Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /autonomy/local_path
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.45
      Name: Vehicle Pose
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 248; 248; 246
    Fixed Frame: slam/map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Global Top Down
      Scale: 45
      Target Frame: slam/map
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
