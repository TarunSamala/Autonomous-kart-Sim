<launch>
  <arg name="enabled" default="false"/>
  <arg name="config" default="$(find-pkg-share autonomy)/config/autonomy.yaml"/>

  <!-- Evaluation-only planner: proves closed-track control before replacing
       testing odometry with a SLAM localization backend. -->
  <node pkg="autonomy" exec="track_reference_planner"
        name="track_reference_planner" output="screen">
    <param from="$(var config)"/>
  </node>

  <node pkg="autonomy" exec="pure_pursuit" name="pure_pursuit" output="screen">
    <param from="$(var config)"/>
    <param name="enabled" value="$(var enabled)"/>
    <param name="require_go" value="false"/>
  </node>
</launch>
