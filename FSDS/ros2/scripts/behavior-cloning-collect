#!/usr/bin/env zsh

set -e

script_path="${0:A}"
if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
run_name="${1:-run-$(date +%Y%m%d-%H%M%S)}"
run_directory="$workspace_root/generated/behavior_cloning/datasets/$run_name"
manifest="$workspace_root/generated/behavior_cloning/hp60c/manifest.json"

if [[ -e "$run_directory" ]]; then
  print -u2 "behavior-cloning-collect: run already exists: $run_directory"
  exit 1
fi
if [[ ! -f "$manifest" ]]; then
  print -u2 "behavior-cloning-collect: run scripts/behavior-cloning-prepare first"
  exit 1
fi

unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
source /opt/ros/humble/setup.zsh
source "$workspace_root/install/setup.zsh"
print "Dataset run: $run_directory"
print "Press E to arm keyboard driving; use behavior-cloning-record start/stop for capture."
exec ros2 launch behavior_cloning collect.launch.xml \
  run_directory:="$run_directory" manifest_path:="$manifest"
