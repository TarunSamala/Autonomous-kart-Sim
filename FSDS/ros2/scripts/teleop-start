#!/usr/bin/env zsh

set -e

script_path="${0:A}"

if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  # This script is also launched by the Unreal HUD without a terminal.
  # KeyboardTeleop reads global X11 key state, so a pseudo-TTY is unnecessary.
  exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
workspace_setup="$workspace_root/install/setup.zsh"

unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
source /opt/ros/humble/setup.zsh

if [[ ! -f "$workspace_setup" ]]; then
  print -u2 "teleop-start: workspace is not built: $workspace_setup"
  exit 1
fi

source "$workspace_setup"

publisher_count="$(ros2 topic info /fsds/control_command 2>/dev/null | awk '/Publisher count:/ {print $3}')"
if [[ -n "$publisher_count" && "$publisher_count" != 0 ]]; then
  print -u2 "teleop-start: /fsds/control_command already has $publisher_count publisher(s)"
  print -u2 "Stop the active autonomy controller or previous teleop process first."
  exit 1
fi

exec ros2 run teleop keyboard_teleop "$@"
