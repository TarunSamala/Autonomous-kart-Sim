#!/usr/bin/env zsh

set -e

script_path="${0:A}"
workspace_root="${script_path:h:h}"
action="${1:-help}"
experiment="${2:-amz_style}"

case "$action" in
  prepare)
    exec "$workspace_root/scripts/single-test-prepare" --experiment "$experiment"
    ;;
  teach|map)
    shift
    exec "$workspace_root/scripts/single-test-teach" "$@"
    ;;
  teach-run|learn-drive)
    shift
    exec "$workspace_root/scripts/single-test-teach-repeat" "$@"
    ;;
  launch|start)
    if (( $# >= 2 )); then
      shift 2
    else
      shift
    fi
    exec "$workspace_root/scripts/single-test-launch" "$experiment" "$@"
    ;;
  arm)
    exec "$workspace_root/scripts/single-test-arm" "$experiment"
    ;;
  stop|disarm)
    exec "$workspace_root/scripts/single-test-disarm"
    ;;
  visualize|rviz)
    exec "$workspace_root/scripts/single-test-visualize" "$experiment"
    ;;
  check|status)
    if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
      exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
    fi
    unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
    source /opt/ros/humble/setup.zsh
    source "$workspace_root/install/setup.zsh"
    python3 -m json.tool "$workspace_root/../settings.json" >/dev/null
    print "settings.json: valid"
    if nc -z -w 1 127.0.0.1 41451 >/dev/null 2>&1; then
      print "FSDS RPC: reachable"
    else
      print "FSDS RPC: not reachable"
    fi
    if ros2 node list 2>/dev/null | grep -qx '/fsds/ros_bridge'; then
      print "ROS bridge: connected"
    else
      print "ROS bridge: not connected"
    fi
    topic_list="$(ros2 topic list 2>/dev/null || true)"
    for topic in /fsds/gss /fsds/testing_only/extra_info /fsds/control_command; do
      if print -r -- "$topic_list" | grep -qx "$topic"; then
        print "$topic: available"
      else
        print "$topic: unavailable"
      fi
    done
    ;;
  help|-h|--help)
    print "usage: single-test ACTION [EXPERIMENT] [OPTIONS]"
    print ""
    print "actions:"
    print "  prepare   Generate/apply settings before FSDS starts"
    print "  teach     Manually drive one lap; save SLAM graph and route"
    print "  teach-run Teach, close/save the map, then transition to autonomous replay"
    print "  launch    Start bridge + stack; prompt once before arming"
    print "  check     Check settings, FSDS RPC, bridge and core topics"
    print "  arm       Arm an already-running stack"
    print "  stop      Disarm and stop result recording"
    print "  rviz      Open RViz using the selected experiment layout"
    print ""
    print "experiments: amz_style, delaunay_reactive, behavior_cloning, slam, slam_stanley, general_autonomy"
    print "example:"
    print "  single-test prepare amz_style  # before starting FSDS"
    print "  single-test teach-run           # manual map, then safe autonomy transition"
    ;;
  *)
    print -u2 "single-test: unknown action: $action"
    print -u2 "Run 'single-test help' for usage."
    exit 2
    ;;
esac
