#!/usr/bin/env zsh

set -e

script_path="${0:A}"
if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
model_directory="${1:-$workspace_root/generated/behavior_cloning/models/rgbd}"
maximum_throttle="${2:-0.20}"
model_path="$model_directory/model.onnx"
metadata_path="$model_directory/model.json"
manifest_path="${3:-$workspace_root/generated/behavior_cloning/hp60c_benchmark/manifest.json}"
results_directory="$workspace_root/results/behavior_cloning/${model_directory:t}"

for required_file in "$model_path" "$metadata_path" "$manifest_path"; do
  if [[ ! -f "$required_file" ]]; then
    print -u2 "behavior-cloning-benchmark: required file not found: $required_file"
    exit 1
  fi
done
if [[ ! "$maximum_throttle" =~ '^(0(\.[0-9]+)?|1(\.0+)?)$' ]]; then
  print -u2 "behavior-cloning-benchmark: maximum throttle must be in [0, 1]"
  exit 2
fi

unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
source /opt/ros/humble/setup.zsh
source "$workspace_root/install/setup.zsh"

publisher_count="$(ros2 topic info /fsds/control_command 2>/dev/null | awk '/Publisher count:/ {print $3}')"
if [[ -n "$publisher_count" && "$publisher_count" != 0 ]]; then
  print -u2 "behavior-cloning-benchmark: /fsds/control_command already has $publisher_count publisher(s)"
  print -u2 "Stop teleop, Pure Pursuit, or a previous controller first."
  exit 1
fi

print "Model: $model_directory"
print "Maximum throttle: $maximum_throttle"
print "Results: $results_directory"
print "Start the timed run from another terminal with behavior-cloning-benchmark-start."
exec ros2 launch behavior_cloning benchmark.launch.xml \
  model_path:="$model_path" \
  metadata_path:="$metadata_path" \
  manifest_path:="$manifest_path" \
  results_directory:="$results_directory" \
  maximum_throttle:="$maximum_throttle"
