#!/usr/bin/env zsh

set -e

script_path="${0:A}"
if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  # Unreal launches this script without a terminal. Requesting a pseudo-TTY
  # from that context can leave distrobox-enter waiting indefinitely.
  exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
source /opt/ros/humble/setup.zsh
source "$workspace_root/install/setup.zsh"

test_config="$workspace_root/src/single_test/config/example_single_test.yaml"
output_root="$workspace_root/generated/single_test"
base_settings="$workspace_root/../settings.json"

if (( $# > 0 )) && [[ "$1" != --* ]]; then
  test_config="$1"
  shift
fi
if (( $# > 0 )) && [[ "$1" != --* ]]; then
  output_root="$1"
  shift
fi

output_settings="$output_root/settings.json"
output_manifest="$output_root/manifest.json"

ros2 run single_test prepare_single_test -- \
  --config "$test_config" \
  --profiles "$workspace_root/src/single_test/config/sensor_profiles.yaml" \
  --base-settings "$base_settings" \
  --output-settings "$output_settings" \
  --output-manifest "$output_manifest" \
  "$@"

# "Apply" means the simulator must read the prepared contract on its next
# launch. Keep a stable recovery copy of the pre-benchmark configuration.
settings_backup="$base_settings.pre-single-test"
if [[ ! -f "$settings_backup" ]]; then
  cp -p "$base_settings" "$settings_backup"
fi
cp -p "$output_settings" "$base_settings"
print "Applied prepared settings to: $base_settings"
print "Restart FSDS before beginning the benchmark."
