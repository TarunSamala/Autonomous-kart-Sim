#!/usr/bin/env zsh

set -e

script_path="${0:A}"
if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  exec distrobox enter --no-tty kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
experiment="${1:-amz_style}"
unset COLCON_CURRENT_PREFIX COLCON_PREFIX_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH
source /opt/ros/humble/setup.zsh
source "$workspace_root/install/setup.zsh"

if [[ "$experiment" == "behavior_cloning" ]]; then
  exec "$workspace_root/scripts/behavior-cloning-benchmark-start"
fi
if [[ "$experiment" != "amz_style" && "$experiment" != "slam" &&
      "$experiment" != "general_autonomy" ]]; then
  print -u2 "single-test-arm: unknown experiment: $experiment"
  exit 2
fi

if ! ros2 service type /single_test/start >/dev/null 2>&1; then
  print -u2 "single-test-arm: Single Test launch is not ready"
  exit 1
fi
if ! ros2 service type /autonomy/enable >/dev/null 2>&1; then
  print -u2 "single-test-arm: autonomy launch is not ready"
  exit 1
fi

enable_response="$(ros2 service call \
  /autonomy/enable std_srvs/srv/SetBool '{data: true}')"
print -r -- "$enable_response"
if [[ "$enable_response" != *"success=True"* &&
      "$enable_response" != *"success: true"* ]]; then
  print -u2 "single-test-arm: autonomy controller refused to arm"
  exit 1
fi

start_response="$(ros2 service call /single_test/start std_srvs/srv/Trigger '{}')"
print -r -- "$start_response"
if [[ "$start_response" != *"success=True"* &&
      "$start_response" != *"success: true"* ]]; then
  print -u2 "single-test-arm: result recorder refused to start; disarming controller"
  ros2 service call /autonomy/enable std_srvs/srv/SetBool '{data: false}' || true
  exit 1
fi
