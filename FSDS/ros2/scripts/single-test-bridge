#!/usr/bin/env zsh

set -e

script_path="${0:A}"
if [[ ! -f /run/.containerenv && ! -f /.dockerenv ]]; then
  exec distrobox enter kart-ros2-humble -- "$script_path" "$@"
fi

workspace_root="${script_path:h:h}"
generated_settings="${1:-$workspace_root/generated/single_test/settings.json}"
if [[ ! -f "$generated_settings" ]]; then
  print -u2 "single-test-bridge: settings not found: $generated_settings"
  exit 1
fi

source /opt/ros/humble/setup.zsh
source "$workspace_root/install/setup.zsh"
export FSDS_SETTINGS_PATH="$generated_settings"
exec ros2 launch fsds_ros2_bridge fsds_ros2_bridge.launch.py
